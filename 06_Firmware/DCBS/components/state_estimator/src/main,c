
// alleen voor het testen van de state estimator, niet in de uiteidelijke codebase!
gyro_data_t gyro;
accel_data_t accel;

state_estimator_init();

while (1)
{
    gyro_driver_read_gyro(&gyro);
    gyro_driver_read_accel(&accel);

    state_estimator_update(&gyro, &accel, 0.01f);

    orientation_t ori = state_estimator_get_orientation();

    printf("Pitch: %.2f Roll: %.2f\n",
           ori.pitch,
           ori.roll);

    vTaskDelay(pdMS_TO_TICKS(10));
}